{
  "name": "ccgo2dsapi",
  "version": "1.0.0",
  "private": true,
  "description": "Serve DeepSeek's three API protocols locally from a Command Code Go plan, with a quota panel",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node vendor/server.mjs",
    "verify": "node tools/verify-all.mjs",
    "verify:openai": "node tools/verify-parity.mjs",
    "verify:anthropic": "node tools/verify-anthropic.mjs",
    "verify:responses": "node tools/verify-responses.mjs",
    "speed": "node tools/measure-speed.mjs --port 8787 --models deepseek-v4.1-flash,deepseek-v4-pro"
  },
  "engines": {
    "node": ">=24"
  }
}
